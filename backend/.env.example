# ==========================================
# 1. APPLICATION & SERVER SETTINGS
# ==========================================
APP_ENV=development
APP_NAME="LCK Airport's AI Assistant"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ==========================================
# 2. GUARDRAIL LLM (Lightweight Safety Gate)
# ==========================================
GUARDRAIL_ENABLED=true
GUARDRAIL_MODEL=ollama/llama3.2:3b
GUARDRAIL_TEMPERATURE=0.0
GUARDRAIL_MAX_TOKENS=100
GUARDRAIL_TIMEOUT_SECONDS=10.0

# ==========================================
# 3. MAIN LLM PROVIDER (Dynamic via LiteLLM)
# ==========================================
LLM_MODEL=ollama/llama3.1:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60.0
# Ollama defaults to 2048 and silently truncates longer prompts, which would cut off most of
# the knowledge snapshot (~7.6k tokens). Ignored by hosted providers. qwen2.5:7b supports 32768.
LLM_NUM_CTX=16384

# LLM Provider Endpoints & Keys (Uncomment as needed)
OLLAMA_API_BASE=http://host.docker.internal:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# ==========================================
# 4. EMBEDDING PROVIDER (Dynamic via LiteLLM)
# ==========================================
EMBEDDING_MODEL=ollama/nomic-embed-text

# ==========================================
# 5. KNOWLEDGE & STORAGE
# ==========================================
STORAGE_PROVIDER=local
DATA_DIR=/app/data
MANIFEST_PATH=/app/data/manifest.json
KNOWLEDGE_DIR=/app/data/lck_airport

# ==========================================
# 6. RAG RETRIEVAL (Dynamic)
# ==========================================
VECTOR_STORE_PROVIDER=in_memory
VECTOR_STORE_PATH=/app/data/vector_db
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_HYBRID_SEARCH_ENABLED=true

# ==========================================
# 7. DATABASE & CONVERSATION MEMORY
# ==========================================
DB_PROVIDER=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lck_assistant
DB_USER=
DB_PASSWORD=
DB_SQLITE_PATH=/app/storage/lck_assistant.db

MEMORY_MAX_TURNS=20
MEMORY_SUMMARIZE_OLDER=true
MEMORY_SESSION_TTL_MINUTES=60
MEMORY_ENABLE_USER_LINKING=true

# ==========================================
# 8. PROMPT CACHING & STREAMING
# ==========================================
CACHE_KNOWLEDGE_CONTEXT=true
CACHE_TTL_SECONDS=3600
CACHE_PROVIDER_NATIVE=true
ENABLE_STREAMING=true

# ==========================================
# 9. SECURITY & REFRESH SECRET
# ==========================================
AUTH_ENABLED=true
KNOWLEDGE_ADMIN_SECRET=lck-admin-change-in-production-secure-token-512bit!

